@Library('jenkins-upstream-library') _

pipeline {
    agent {
        docker {
            image 'quay.io/rh_ee_ahonkala/console-e2e-ci:v22.06.26'
            args '-v /etc/resolv.conf:/etc/resolv.conf -v /run/containerd/containerd.sock:/run/containerd/containerd.sock'
            label 'jump-vpc-x86_64'
        }
    }
    options { disableConcurrentBuilds() }
    parameters {
        string(defaultValue: '', description: 'OCP Build (quay image or build number)', name: 'Build')
        string(defaultValue: '', description: 'OCP Release version (e.g. 4.17)', name: 'Release')
        string(defaultValue: '0', description: 'Time (in minutes) to retain cluster after tests. 0 = destroy immediately', name: 'KeepFor')
        string(name: 'Suite', defaultValue: 'Network_Observability', description: 'Cypress suite to run (e.g. Network_Observability or path tests/dir/suite.cy.ts)')
        string(name: 'Retries', defaultValue: '2', description: 'Number of retries on test failure')
    }

    environment {
        // Credentials — all must be defined in Jenkins Credentials store
        GITHUB_USER         = credentials('GITHUB_USER')
        GITHUB_TOKEN        = credentials('GITHUB_TOKEN')
        OS_USERNAME         = credentials('OS_USERNAME')
        OS_PASSWORD         = credentials('OS_PASSWORD')
        ARTIFACTORY_USER    = credentials('ARTIFACTORY_USER')
        ARTIFACTORY_TOKEN   = credentials('ARTIFACTORY_TOKEN')
        REDHAT_USERNAME     = credentials('REDHAT_USERNAME')
        REDHAT_PASSWORD     = credentials('REDHAT_PASSWORD')
        PULL_SECRET         = credentials('PULL_SECRET')
        IBMCLOUD_API_KEY    = credentials('IBM_PCLOUD_QE_API_KEY')

        // Job parameters
        OCP_RELEASE         = "${params.Release}"
        BUILD               = "${params.Build}"
        TIMEOUT             = "${params.KeepFor}"

        // Cluster config
        CONFIG_TYPE         = "min"
        ENABLE_E2E_TEST     = "false"
        KDUMP_ENABLE        = "false"

        // PowerVC / Terraform config
        HARDWARE_CHOSE            = "P9"
        TARGET                    = "deploy-openshift4-powervc"
        TEMPLATE_FILE             = ".${TARGET}.tfvars.template"
        TERRAFORM_VER             = "1.9.6"
        POWERVS                   = "false"
        SCRIPT_DEPLOYMENT         = "false"
        WAIT_FOR_DEBUG            = "0"
        OPENSHIFT_POWERVC_GIT_TF_DEPLOY_BRANCH = "main"

        // Console UI e2e / NETobserv test vars
        ENABLE_CONSOLE_E2E_TEST = "true"
        DRIVER                  = "Cypress"
        SUITE2RUN               = "${params.Suite}"
        RETRIES                 = "${params.Retries}"
        JTIMEOUT                = "180000"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.Release?.trim()) {
                        error("'Release' parameter is required (e.g. 4.17). Please re-run with 'Build with Parameters'.")
                    }
                    if (!params.Build?.trim()) {
                        error("'Build' parameter is required (quay image or build number). Please re-run with 'Build with Parameters'.")
                    }
                }
            }
        }

        stage('Clone ansible extras') {
            steps {
                cloneRepo("https://github.com/ocp-power-automation/ocp4-playbooks-extras", "ocp4-playbooks-extras", "*/main")
            }
        }

        stage('Setup Common Environment Variables') {
            steps {
                setupCommonEnvironmentVariables()
                setupClusterConfig("${CONFIG_TYPE}")
                script {
                    env.INSTANCE_NAME   = "rdr-zstream-p9"
                    env.BASTION_VCPUS   = "1"
                    env.BOOTSTRAP_VCPUS = "1"
                    env.BOOTSTRAP_MEMORY = "8"
                    env.MOUNT_ETCD_RAMDISK = "false"
                    env.SETUP_SQUID_PROXY  = "true"

                    if (env.OCP_RELEASE == "4.14") {
                        env.REDHAT_RELEASE  = "9.2"
                        env.GOLANG_TARBALL  = "https://golang.org/dl/go1.21.0.linux-ppc64le.tar.gz"
                    } else if (env.OCP_RELEASE == "4.15") {
                        env.REDHAT_RELEASE  = "9.3"
                        env.GOLANG_TARBALL  = "https://golang.org/dl/go1.22.0.linux-ppc64le.tar.gz"
                    } else if (env.OCP_RELEASE == "4.16") {
                        env.REDHAT_RELEASE  = "9.4"
                        env.GOLANG_TARBALL  = "https://golang.org/dl/go1.22.0.linux-ppc64le.tar.gz"
                    } else {
                        env.REDHAT_RELEASE  = "9.6"
                        env.GOLANG_TARBALL  = "https://golang.org/dl/go1.24.9.linux-ppc64le.tar.gz"
                    }

                    if (env.OCP_RELEASE == "4.19" || env.OCP_RELEASE == "4.21") {
                        env.RHCOS_RELEASE = "4.19"
                    } else if (env.OCP_RELEASE == "4.22" || env.OCP_RELEASE == "5.0") {
                        env.RHCOS_RELEASE = "9.8"
                    } else {
                        env.RHCOS_RELEASE = "${env.OCP_RELEASE}"
                    }

                    // Use stable (GA) URLs for released versions; dev-preview for pre-release
                    def stableReleases = ["4.14", "4.15", "4.16", "4.17", "4.18"]
                    if (stableReleases.contains(env.OCP_RELEASE)) {
                        env.OPENSHIFT_INSTALL_TARBALL    = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp/latest-${OCP_RELEASE}/ppc64le/openshift-install-linux.tar.gz"
                        env.OPENSHIFT_CLIENT_TARBALL     = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp/latest-${OCP_RELEASE}/ppc64le/openshift-client-linux.tar.gz"
                        env.OPENSHIFT_CLIENT_TARBALL_AMD64 = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp/latest-${OCP_RELEASE}/amd64/openshift-client-linux.tar.gz"
                    } else {
                        env.OPENSHIFT_INSTALL_TARBALL    = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp-dev-preview/candidate-${OCP_RELEASE}/ppc64le/openshift-install-linux.tar.gz"
                        env.OPENSHIFT_CLIENT_TARBALL     = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp-dev-preview/candidate-${OCP_RELEASE}/ppc64le/openshift-client-linux.tar.gz"
                        env.OPENSHIFT_CLIENT_TARBALL_AMD64 = "https://mirror.openshift.com/pub/openshift-v4/multi/clients/ocp-dev-preview/candidate-${OCP_RELEASE}/amd64/openshift-client-linux.tar.gz"
                    }
                }
            }
        }

        stage('Pull artifacts') {
            steps {
                script {
                    getArtifacts("powervm/poll-powervc-images", "cicd-rhcos-${RHCOS_RELEASE}.latest.txt")
                    getArtifacts("powervm/poll-powervc-images", "cicd-rhel-${REDHAT_RELEASE}.latest.txt")
                }
            }
        }

        stage('Prepare Terraform Template') {
            steps {
                script {
                    ansiColor('xterm') { echo "" }
                    try {
                        gbToMb()
                        pullSecret()
                        env.OPENSHIFT_IMAGE = ""
                        if (env.BUILD?.trim()) {
                            if (!env.BUILD.contains('quay')) {
                                env.OPENSHIFT_IMAGE = "docker-na.artifactory.swg-devops.com/sys-powercloud-docker-local/ocp-ppc64le/release-ppc64le:${env.BUILD}"
                                sh '''
                                    nerdctl login -u ${ARTIFACTORY_USER} -p ${ARTIFACTORY_TOKEN} docker-na.artifactory.swg-devops.com/sys-powercloud-docker-local
                                    nerdctl pull ${OPENSHIFT_IMAGE}
                                    if [ $? -ne 0 ]; then
                                        echo "${OPENSHIFT_IMAGE} not found"
                                        exit 1
                                    fi
                                    nerdctl rmi ${OPENSHIFT_IMAGE}
                                '''
                            } else {
                                env.OPENSHIFT_IMAGE = env.BUILD
                            }
                        } else {
                            echo "BUILD parameter is empty"
                            throw err
                        }

                        currentBuild.description = "OCP Build: ${env.OPENSHIFT_IMAGE.split(':')[1].trim()}"

                        if (fileExists("deploy/artifactory/cicd-rhcos-${RHCOS_RELEASE}.latest.txt")) {
                            env.RHCOS_IMAGE      = readFile "deploy/artifactory/cicd-rhcos-${RHCOS_RELEASE}.latest.txt"
                            env.RHCOS_IMAGE_NAME = env.RHCOS_IMAGE.split()[0].trim()
                            env.RHCOS_IMAGE_ID   = env.RHCOS_IMAGE.split()[1].trim()
                        } else {
                            echo "cicd-rhcos-${RHCOS_RELEASE}.latest.txt not found. Check poll-powervc-images job."
                            throw err
                        }
                        if (fileExists("deploy/artifactory/cicd-rhel-${REDHAT_RELEASE}.latest.txt")) {
                            env.BASTION_IMAGE      = readFile "deploy/artifactory/cicd-rhel-${REDHAT_RELEASE}.latest.txt"
                            env.BASTION_IMAGE_NAME = env.BASTION_IMAGE.split()[0].trim()
                            env.BASTION_IMAGE_ID   = env.BASTION_IMAGE.split()[1].trim()
                        } else {
                            echo "cicd-rhel-${REDHAT_RELEASE}.latest.txt not found. Check poll-powervc-images job."
                            throw err
                        }
                        if (env.DEPLOY_MASTER == "false") {
                            echo "Cluster cannot be deployed without master nodes"
                            throw err
                        }

                        createTemplate(env.OS_AUTH_URL, env.MASTER_VCPUS,    "${MASTER_MEMORY_MB}",    env.MASTER_PROCESSORS,    env.MASTER_TEMPLATE)
                        createTemplate(env.OS_AUTH_URL, env.WORKER_VCPUS,    "${WORKER_MEMORY_MB}",    env.WORKER_PROCESSORS,    env.WORKER_TEMPLATE)
                        createTemplate(env.OS_AUTH_URL, env.BASTION_VCPUS,   "${BASTION_MEMORY_MB}",   env.BASTION_PROCESSORS,   env.BASTION_TEMPLATE)
                        createTemplate(env.OS_AUTH_URL, env.BOOTSTRAP_VCPUS, "${BOOTSTRAP_MEMORY_MB}", env.BOOTSTRAP_PROCESSORS, env.BOOTSTRAP_TEMPLATE)
                    }
                    catch (err) {
                        echo 'Error! Template preparation failed!'
                        env.FAILED_STAGE = env.STAGE_NAME
                        throw err
                    }
                }
            }
        }

        stage('Initialize Environment') {
            steps {
                initializeEnvironment()
            }
        }

        stage('Setup Terraform Plugin') {
            steps {
                setupTerraformPlugin()
            }
        }

        stage('Deploy OCP Cluster') {
            steps {
                deployCluster()
            }
        }

        stage('Run crontab capture script') {
            steps {
                crontabCommandCaptureScript()
            }
        }

        stage('Setup Kubectl') {
            steps {
                setupKubeconfigOcp4()
            }
        }

        // ── NETobserv-specific stages ──────────────────────────────────────────
        stage('Setup NETobserv frontend test environment') {
            steps {
                sh 'bash ${WORKSPACE}/scripts/netobserv/set_up.sh'
            }
        }

        stage('Debug: netobserv pod status') {
            steps {
                sh '''
                    export KUBECONFIG=/host/kubeconfig
                    echo "====== Pods in netobserv namespace ======"
                    oc get pods -n netobserv -o wide || true
                    echo "====== Plugin pod describe ======"
                    oc describe pod -l app=netobserv-plugin -n netobserv || true
                    echo "====== Loki pod describe ======"
                    oc describe pod -l app=loki -n netobserv || true
                    echo "====== FlowCollector status ======"
                    oc get flowcollector cluster -o yaml | grep -A10 "conditions:" || true
                    echo "====== NetObserv operator CSV ======"
                    oc get csv -n openshift-netobserv-operator || true
                '''
            }
        }

        stage('Gather pprof and prometheus data') {
            steps {
                gatherPrometheusData()
            }
        }

        stage('Wait to retain cluster (optional)') {
            steps {
                script {
                    ansiColor('xterm') { echo "" }
                    try {
                        def timeoutMin = TIMEOUT.toInteger()
                        if (timeoutMin != 0) {
                            echo "Holding cluster teardown for ${timeoutMin} minutes"
                            sleep timeoutMin * 60
                        }
                    }
                    catch (err) {
                        echo 'Error! Timeout stage failed!'
                        env.FAILED_STAGE = env.STAGE_NAME
                        throw err
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                ansiColor('xterm') { echo "" }
                try {
                    sh '''
                        echo "Copying NETobserv test output ..."
                        cp -rf /host/out-*   ${WORKSPACE}/deploy || true
                        cp -rf /host/*.txt   ${WORKSPACE}/deploy || true
                        cp     /host/input.json ${WORKSPACE}/deploy || true
                    '''
                    archiveAllArtifacts(
                        "deploy/conformance-parallel-out.txt.tar.gz",
                        "deploy/summary.txt",
                        "deploy/vars.tfvars",
                        "cpu-pre.pprof",
                        "heap-pre.pprof",
                        "prometheus.tar.gz",
                        "deploy/cron.log",
                        "deploy/${SUITE2RUN}-*.txt",
                        "deploy/input.json",
                        "deploy/out-*/cypress/*"
                    )
                    storeMustGatherLogs()
                    checkInfraError()
                    processE2eResults()
                }
                catch (err) {
                    echo 'Error in post-always block!'
                }
                finally {
                    cleanupOcp4Cluster()
                    cleanWs()
                }
            }
        }
    }
}
